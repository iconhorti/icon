# OS / Editor
.DS_Store
Thumbs.db
*.tmp

# Word / Excel lock files
~$*

# Python
__pycache__/
*.pyc
*.pyo

# Node (already in web/.gitignore)
node_modules/

# Expo
mobile/.expo/
mobile/dist/

# SQLite databases (dev only — keep backend/*.db out of repo)
*.db
*.db-shm
*.db-wal

# Dev-only JWT signing key (auto-generated by auth_dep.py) — never commit secrets
backend/.dev_secret_key

# Local AI tool config / credentials — never commit
claude.json
git id and pw.txt

# Obsidian personal vault
.obsidian/

# Superpowers brainstorm session files (large, transient)
.superpowers/brainstorm/*/content/
.superpowers/brainstorm/*/state/

# User-uploaded documents (farmer KYC/land records — personal data, never commit)
backend/uploads/
uploads/

# Logs and build artifacts
backend/error.log
*.log
*.tsbuildinfo

# Windows reserved-name artifacts (accidental `> nul` redirects on Git Bash)
nul
**/nul

# Credentials documents — never commit
DEFAULT ID AND PW.docx
